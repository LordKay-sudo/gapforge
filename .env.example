# Neo4j (local or Docker service name "neo4j")
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# API
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Docker Compose overrides (set automatically in compose file)
# NEO4J_URI=bolt://neo4j:7687

# Embabel MCP — required for docker-compose.full.yml / docker-compose.mcp.yml
OPENAI_API_KEY=your_openrouter_or_openai_key
OPENAI_BASE_URL=https://openrouter.ai
# EMBABEL_DEFAULT_LLM=x-ai/grok-4.1-fast:free

# Full agent stack (one command):
#   docker compose -f docker-compose.full.yml up --build
# See docs/ONTOHARNESS_DEMO.md

# OntoHarness semantic gate (set automatically in docker-compose.full.yml)
ONTOHARNESS_ENABLED=false
ONTOHARNESS_BASE_URL=http://localhost:8010
ONTOHARNESS_DOMAIN=biomedical
ONTOHARNESS_TIMEOUT_SECONDS=10
# When true, unreachable OntoHarness skips validation; set false for strict HITL
ONTOHARNESS_FAIL_OPEN=true
