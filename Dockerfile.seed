FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/api

COPY api/requirements-seed.txt /tmp/requirements-seed.txt
RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /tmp/requirements-seed.txt

COPY api/app /app/api/app
COPY api/tests/fixtures/opentargets_slice_v2.json /app/data/raw/opentargets_slice_v2.json
COPY scripts /app/scripts
COPY data /app/data

CMD ["/bin/sh", "-c", "python /app/scripts/etl_opentargets.py && python /app/scripts/seed_neo4j.py"]
